# Application settings. Copy this file to .env for local overrides.
HONEY_CHAIN_APP_NAME=Honey Chain API
HONEY_CHAIN_ENVIRONMENT=development

# Replace CHANGE_ME with a local password when PostgreSQL requires one.
# Do not commit a real .env file.
HONEY_CHAIN_DATABASE_URL=postgresql+psycopg://honey_chain_app:CHANGE_ME@127.0.0.1:5432/honey_chain

# Authentication: provide a high-entropy local secret; never commit a real value.
HONEY_CHAIN_JWT_SECRET=
HONEY_CHAIN_JWT_ALGORITHM=HS256
HONEY_CHAIN_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Used only by the explicit demo-user seed command. Use a local-only value.
HONEY_CHAIN_DEMO_PASSWORD=
