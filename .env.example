# =============================================================================
# Honey Chain Environment Configuration Template
# =============================================================================
# Copy this file to .env before starting the Docker Compose stack:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# 1. Never commit real credentials, production secrets, or private keys to git.
# 2. Distinguish server-only secrets from client-exposed variables.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=honey_chain_app
POSTGRES_PASSWORD=honey_chain_secret_change_in_production
POSTGRES_DB=honey_chain
# Host port mapping: use 5432, or 5433 if your host already runs local PostgreSQL
POSTGRES_PORT=5433

# -----------------------------------------------------------------------------
# 2. Backend API Service Configuration
# -----------------------------------------------------------------------------
HONEY_CHAIN_APP_NAME=Honey Chain API
HONEY_CHAIN_ENVIRONMENT=development

# JWT Secret: must be a high-entropy string of at least 32 characters
HONEY_CHAIN_JWT_SECRET=dev_jwt_secret_must_be_at_least_32_characters_long_for_hs256
HONEY_CHAIN_JWT_ALGORITHM=HS256
HONEY_CHAIN_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Initial Demo Password (used to seed demo.admin, demo.beekeeper, demo.processor)
HONEY_CHAIN_DEMO_PASSWORD=cL8HERnhzmffQwza49BbIQ

# Public Origin: URL consumers and browsers use to reach the platform
HONEY_CHAIN_PUBLIC_ORIGIN=http://localhost:3000

# Automatically seed the 3 default demo authentication accounts on first startup
AUTO_SEED_DEMO_USERS=true

# AI Service URL (inside Compose network this resolves to the ai-service container)
HONEY_CHAIN_AI_URL=http://ai-service:5050

# -----------------------------------------------------------------------------
# 3. Frontend Service Configuration
# -----------------------------------------------------------------------------
# Internal backend URL used by Next.js proxy rewrite layer
BACKEND_API_URL=http://backend:8000

# -----------------------------------------------------------------------------
# 4. Optional Blockchain Integration (Ethereum JSON-RPC)
# -----------------------------------------------------------------------------
# Set to 'true' only if connecting to an active EVM node (e.g. Hardhat / Sepolia)
HONEY_CHAIN_BLOCKCHAIN_ENABLED=false
HONEY_CHAIN_BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
HONEY_CHAIN_BLOCKCHAIN_CONTRACT_ADDRESS=
HONEY_CHAIN_BLOCKCHAIN_CHAIN_ID=31337
HONEY_CHAIN_BLOCKCHAIN_NETWORK_NAME=localhost
HONEY_CHAIN_BLOCKCHAIN_PRIVATE_KEY=
